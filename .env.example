# Copy to .env.local. Without these, the mock commerce provider is used.

# Shopify Storefront API (roadmap phase 5)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-10
# Used to verify product/inventory webhooks (roadmap 5.3)
SHOPIFY_WEBHOOK_SECRET=

# Public site URL (sitemap, canonical URLs, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
